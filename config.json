    { "id": "files", "name": "Files", "match": "explorer", "launch": "explorer.exe", "icon": "shell:AppsFolder\\Microsoft.Windows.Explorer", "pinned": true },
    { "id": "excel", "name": "Excel", "match": "EXCEL", "launch": "shell:AppsFolder\\Microsoft.Office.EXCEL.EXE.15", "pinned": false },
    { "id": "word", "name": "Word", "match": "WINWORD", "launch": "shell:AppsFolder\\Microsoft.Office.WINWORD.EXE.15", "pinned": false }
